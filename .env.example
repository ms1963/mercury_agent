# Copy to ~/.mercury/.env  (or export in your environment). Never commit real keys.
# Configure AT LEAST ONE LLM provider — Mercury has no built-in model.

# --- OpenRouter (remote; also enables the optional Jev decision model) ---
# OPENROUTER_API_KEY=sk-or-...

# --- OpenAI / OpenAI-compatible cloud ---
# OPENAI_API_KEY=sk-...

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- A custom OpenAI-compatible endpoint: name the var in llm.providers.<id>.apiKeyEnv ---
# MYAPI_KEY=...

# Ollama and LM Studio run locally and need NO key — just enable them in config.yaml.

# Server secret for signing auth tokens (auto-generated if unset; set in production).
# MERCURY_JWT_SECRET=change-me-to-a-long-random-string
