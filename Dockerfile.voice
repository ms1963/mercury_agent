# Mercury — voice-enabled image (offline STT/TTS baked in).
# Same as the default Dockerfile, plus ffmpeg + openai-whisper + piper-tts so the
# `whisper` / `piper` voice presets work inside the container with no host setup.
# Larger than the default image (CPU-only torch); build only if you need in-container voice.
#   docker build -f Dockerfile.voice -t mercury-agent:voice .
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
RUN npm ci && npm run build && npm prune --omit=dev

FROM node:22-slim
# python3-pip + ffmpeg for the voice engines; git/ca-certificates as in the base image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv ffmpeg git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
# Offline voice engines. CPU-only torch keeps the image far smaller than the CUDA default.
# PEP 668 marks the system env "externally managed", so --break-system-packages is required.
RUN pip3 install --no-cache-dir --break-system-packages \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      openai-whisper piper-tts
WORKDIR /app
COPY --from=build /app /app
COPY locales ./locales
COPY docs ./docs
COPY skills ./skills
COPY workflows ./workflows
COPY personalities ./personalities
COPY tools ./tools
ENV NODE_ENV=production MERCURY_HOME=/data
# /data is written at runtime as the non-root `node` user, so it must own it.
# Whisper caches downloaded models under $XDG_CACHE_HOME — keep it on the writable volume.
ENV XDG_CACHE_HOME=/data/.cache
RUN mkdir -p /data && chown -R node:node /data
VOLUME /data
EXPOSE 3000
USER node
CMD ["node", "packages/cli/dist/bin.js", "serve", "--host", "0.0.0.0", "--port", "3000"]
