[Unit]
Description=Mercury agentic AI platform
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/mercury
Environment=NODE_ENV=production
Environment=MERCURY_DB=/home/ubuntu/mercury/mercury.db
ExecStart=/usr/bin/node /home/ubuntu/mercury/packages/cli/dist/bin.js serve --port 3000 --host 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
