# systemd unit — copy to /etc/systemd/system/mercury.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now mercury
[Unit]
Description=Mercury agentic AI platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mercury
WorkingDirectory=/opt/mercury
Environment=NODE_ENV=production
Environment=MERCURY_HOME=/var/lib/mercury
EnvironmentFile=-/etc/mercury.env
ExecStart=/usr/bin/node /opt/mercury/packages/cli/dist/bin.js serve --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mercury

[Install]
WantedBy=multi-user.target
