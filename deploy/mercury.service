[Unit]
Description=Mercury Agent server (HTTP API + web UI)
After=network-online.target
Wants=network-online.target
# /home/ubuntu mounts late at boot (nofail) — never start before the project files exist.
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/mercury
# HOME must be set so Mercury finds ~/.mercury (.env, config.yaml, mercury.db).
Environment=HOME=/home/ubuntu
# Scheduler evaluates cron/natural-language times in the process's local time zone.
# The VM clock is UTC, so without this "5pm" would be scheduled as 17:00 UTC (18:00 CET).
# Set to the operator's time zone so "at 5pm" means 5pm local. Override as needed.
Environment=TZ=Europe/Berlin
ExecStart=/usr/bin/node /home/ubuntu/mercury/packages/cli/dist/bin.js serve --host 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
# Sandboxing. Mercury writes only to ~/.mercury (db, workspace, logs) and the
# project directory (addins / skills installs); everything else is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.mercury /home/ubuntu/mercury
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
