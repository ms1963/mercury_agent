[Unit]
Description=Mercury Agent server (HTTP API + web UI)
After=network-online.target
Wants=network-online.target
# /home/ubuntu mounts late at boot (nofail) — never start before the project files exist.
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/mercury
# HOME must be set so Mercury finds ~/.mercury (.env, config.yaml, mercury.db).
Environment=HOME=/home/ubuntu
ExecStart=/usr/bin/node /home/ubuntu/mercury/packages/cli/dist/bin.js serve --host 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
