[Unit]
Description=Mercury Agent server (HTTP API + web UI)
After=network-online.target
Wants=network-online.target
# /home/ubuntu mounts late at boot (nofail) — never start before the project files exist.
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/mercury
# HOME must be set so Mercury finds ~/.mercury (.env, config.yaml, mercury.db).
Environment=HOME=/home/ubuntu
# No TZ is pinned here on purpose: the scheduler evaluates cron/natural-language times
# in the process's local time zone, and the service inherits the HOST computer's zone
# (/etc/localtime) so Mercury's time zone always matches the machine it runs on.
# Set the machine's zone with: sudo timedatectl set-timezone <Area/City>
ExecStart=/usr/bin/node /home/ubuntu/mercury/packages/cli/dist/bin.js serve --host 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
# Sandboxing. Mercury writes only to ~/.mercury (db, workspace, logs) and the
# project directory (addins / skills installs); everything else is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.mercury /home/ubuntu/mercury
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
