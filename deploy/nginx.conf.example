# Mercury Agent reverse proxy example (HTTP API + web UI, WebSocket-capable).
# Copy to /etc/nginx/conf.d/mercury.conf, set server_name, and terminate TLS here
# (e.g. certbot --nginx) — never expose Mercury's port directly to the internet.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    server_name mercury.example.com;   # <- your host name

    # Caching is controlled by the app: /api, /mcp, /metrics and webhook responses are
    # sent with "Cache-Control: no-store". Do not add a shared-cache directive here: an
    # edge cache could serve one user's authenticated JSON to another user.

    # Webhooks and attachments can carry uploads; keep in line with server.maxBodyBytes.
    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:3000;   # Mercury's server.host/server.port
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}
