# ---------------------------------------------------------------------------
# Anthropic (Claude)  (built-in provider — auto-enables when the key is present)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-...

# Default model (format is provider/model):
MERCURY_MODEL=anthropic/claude-sonnet-4-5
# Cheaper/faster option: anthropic/claude-haiku-4-5
