# ---------------------------------------------------------------------------
# Azure OpenAI  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in the three placeholders below.
# Portal: https://portal.azure.com  ->  your Azure OpenAI resource -> Keys and Endpoint
#
# NOTE: Azure authenticates with an `api-key` HEADER (not a Bearer token) and
# requires an `api-version` query string. Both are handled below via `headers`
# and by putting api-version in the baseUrl. Replace:
#   <RESOURCE>   your resource name (e.g. my-company)
#   <DEPLOYMENT> your model deployment name
#   <API-VERSION> e.g. 2024-10-21
# ---------------------------------------------------------------------------

AZURE_OPENAI_API_KEY=...

# Register Azure as an OpenAI-compatible provider. The api-key header carries the
# key, so apiKeyEnv is omitted here on purpose:
MERCURY__llm__providers__azure={"type":"openai-compatible","baseUrl":"https://<RESOURCE>.openai.azure.com/openai/deployments/<DEPLOYMENT>?api-version=<API-VERSION>","headers":{"api-key":"REPLACE_WITH_AZURE_OPENAI_API_KEY"}}

# Default model: on Azure the "model" is your deployment name.
MERCURY_MODEL=azure/<DEPLOYMENT>

# Tip: keep the real key only in the headers value above; the AZURE_OPENAI_API_KEY
# line is a reminder of where it came from. Do not commit a filled-in file.
