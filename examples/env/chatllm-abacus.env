# ---------------------------------------------------------------------------
# Abacus.AI ChatLLM / RouteLLM  (built-in provider — auto-enables when key present)
# OpenAI-compatible endpoint at https://routellm.abacus.ai/v1
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://apps.abacus.ai  (ChatLLM / RouteLLM)
# ---------------------------------------------------------------------------

CHATLLM_API_KEY=s2-...
# (ABACUS_API_KEY is also accepted if you already have that set.)

# Default model (format is provider/model):
MERCURY_MODEL=chatllm/route-llm
# Other options: chatllm/gpt-4o-mini, chatllm/claude-sonnet-4-5, ...
