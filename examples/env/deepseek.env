# ---------------------------------------------------------------------------
# DeepSeek  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------

DEEPSEEK_API_KEY=sk-...

# Register DeepSeek as an OpenAI-compatible provider (one line, JSON value):
MERCURY__llm__providers__deepseek={"type":"openai-compatible","baseUrl":"https://api.deepseek.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY"}

# Default model (format is provider/model):
MERCURY_MODEL=deepseek/deepseek-chat
# Other options: deepseek/deepseek-reasoner
