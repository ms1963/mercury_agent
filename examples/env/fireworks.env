# ---------------------------------------------------------------------------
# Fireworks AI  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://fireworks.ai/account/api-keys
# ---------------------------------------------------------------------------

FIREWORKS_API_KEY=fw_...

# Register Fireworks as an OpenAI-compatible provider (one line, JSON value):
MERCURY__llm__providers__fireworks={"type":"openai-compatible","baseUrl":"https://api.fireworks.ai/inference/v1","apiKeyEnv":"FIREWORKS_API_KEY"}

# Default model (format is provider/model; Fireworks model ids are full paths):
MERCURY_MODEL=fireworks/accounts/fireworks/models/llama-v3p3-70b-instruct
