# ---------------------------------------------------------------------------
# Google Gemini  (via Gemini's OpenAI-compatible endpoint — registered inline)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------

GEMINI_API_KEY=AIza...

# Register Gemini's OpenAI-compatible endpoint as a provider (one line, JSON value):
MERCURY__llm__providers__gemini={"type":"openai-compatible","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","apiKeyEnv":"GEMINI_API_KEY"}

# Default model (format is provider/model):
MERCURY_MODEL=gemini/gemini-2.0-flash
# Other options: gemini/gemini-2.0-flash-lite, gemini/gemini-1.5-pro, ...
