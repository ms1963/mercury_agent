# ---------------------------------------------------------------------------
# Groq  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://console.groq.com/keys
# ---------------------------------------------------------------------------

GROQ_API_KEY=gsk_...

# Register Groq as an OpenAI-compatible provider (one line, JSON value):
MERCURY__llm__providers__groq={"type":"openai-compatible","baseUrl":"https://api.groq.com/openai/v1","apiKeyEnv":"GROQ_API_KEY"}

# Default model (format is provider/model):
MERCURY_MODEL=groq/llama-3.3-70b-versatile
# Other options: groq/llama-3.1-8b-instant, groq/mixtral-8x7b-32768, ...
