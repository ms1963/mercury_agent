# ---------------------------------------------------------------------------
# LM Studio  (local models — no API key needed)
# Runs on your own machine. Start LM Studio's local server (default port 1234).
# Copy to ~/.mercury/.env.
# ---------------------------------------------------------------------------

# Register the local LM Studio provider (one line). Default endpoint is
# http://localhost:1234/v1 — set baseUrl only if you changed the port/host.
MERCURY__llm__providers__lmstudio={"type":"lmstudio","enabled":true}

# Default model (format is provider/model). Use the model id shown in LM Studio,
# or the generic placeholder below if you only have one loaded:
MERCURY_MODEL=lmstudio/local-model
