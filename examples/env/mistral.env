# ---------------------------------------------------------------------------
# Mistral AI  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://console.mistral.ai/api-keys
# ---------------------------------------------------------------------------

MISTRAL_API_KEY=...

# Register Mistral as an OpenAI-compatible provider (one line, JSON value):
MERCURY__llm__providers__mistral={"type":"openai-compatible","baseUrl":"https://api.mistral.ai/v1","apiKeyEnv":"MISTRAL_API_KEY"}

# Default model (format is provider/model):
MERCURY_MODEL=mistral/mistral-large-latest
# Other options: mistral/mistral-small-latest, mistral/open-mistral-nemo, ...
