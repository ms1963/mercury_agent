# ---------------------------------------------------------------------------
# Ollama  (local models — no API key needed)
# Runs on your own machine. Install: https://ollama.com  then e.g. `ollama pull llama3.1`
# Copy to ~/.mercury/.env.
# ---------------------------------------------------------------------------

# Register the local Ollama provider (one line). Default endpoint is
# http://localhost:11434/v1 — set baseUrl only if you changed Ollama's port/host.
MERCURY__llm__providers__ollama={"type":"ollama","enabled":true}

# Default model (format is provider/model; must be a model you've pulled):
MERCURY_MODEL=ollama/llama3.1
# Other options: ollama/qwen2.5, ollama/mistral, ...
