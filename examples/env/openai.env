# ---------------------------------------------------------------------------
# OpenAI  (built-in provider — auto-enables when the key is present)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------

OPENAI_API_KEY=sk-...

# Default model (any OpenAI model works; format is provider/model):
MERCURY_MODEL=openai/gpt-4o-mini
# Other options: openai/gpt-4o, openai/o4-mini, ...
