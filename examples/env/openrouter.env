# ---------------------------------------------------------------------------
# OpenRouter  (built-in provider — auto-enables when the key is present)
# One key, hundreds of models. Also powers Mercury's optional Jev decision model.
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://openrouter.ai/keys
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=sk-or-...

# Default model. On OpenRouter the model id itself contains a slash, so the full
# Mercury id looks like openrouter/<vendor>/<model>:
MERCURY_MODEL=openrouter/openai/gpt-4o-mini
# Other options: openrouter/anthropic/claude-sonnet-4-5, openrouter/google/gemini-2.0-flash-001, ...
