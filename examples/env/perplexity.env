# ---------------------------------------------------------------------------
# Perplexity  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://www.perplexity.ai/settings/api
# ---------------------------------------------------------------------------

PERPLEXITY_API_KEY=pplx-...

# Register Perplexity as an OpenAI-compatible provider (one line, JSON value):
MERCURY__llm__providers__perplexity={"type":"openai-compatible","baseUrl":"https://api.perplexity.ai","apiKeyEnv":"PERPLEXITY_API_KEY"}

# Default model (format is provider/model):
MERCURY_MODEL=perplexity/sonar
# Other options: perplexity/sonar-pro, perplexity/sonar-reasoning, ...
