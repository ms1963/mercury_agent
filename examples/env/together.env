# ---------------------------------------------------------------------------
# Together AI  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://api.together.xyz/settings/api-keys
# ---------------------------------------------------------------------------

TOGETHER_API_KEY=...

# Register Together as an OpenAI-compatible provider (one line, JSON value):
MERCURY__llm__providers__together={"type":"openai-compatible","baseUrl":"https://api.together.xyz/v1","apiKeyEnv":"TOGETHER_API_KEY"}

# Default model (format is provider/model; Together model ids contain slashes):
MERCURY_MODEL=together/meta-llama/Llama-3.3-70B-Instruct-Turbo
# Other options: together/mistralai/Mixtral-8x7B-Instruct-v0.1, ...
