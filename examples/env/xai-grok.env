# ---------------------------------------------------------------------------
# xAI (Grok)  (OpenAI-compatible — registered inline, no config.yaml needed)
# Copy to ~/.mercury/.env and fill in your key.
# Get a key: https://console.x.ai
# ---------------------------------------------------------------------------

XAI_API_KEY=xai-...

# Register xAI as an OpenAI-compatible provider (one line, JSON value):
MERCURY__llm__providers__xai={"type":"openai-compatible","baseUrl":"https://api.x.ai/v1","apiKeyEnv":"XAI_API_KEY"}

# Default model (format is provider/model):
MERCURY_MODEL=xai/grok-2-latest
# Other options: xai/grok-2-vision-latest, ...
