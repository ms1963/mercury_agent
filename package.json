{
  "name": "mercury-agent",
  "version": "1.8.1",
  "private": true,
  "description": "Mercury - an extensible, self-hosted agentic AI platform (TypeScript)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/core",
    "packages/tools",
    "packages/mcp",
    "packages/gateway",
    "packages/runtime",
    "packages/server",
    "packages/cli"
  ],
  "bin": {
    "mercury": "packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b packages/cli packages/server",
    "postbuild": "chmod +x packages/cli/dist/bin.js",
    "clean": "tsc -b --clean packages/cli packages/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc -b packages/cli packages/server --noEmit false && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -b packages/cli packages/server && tsc -p tsconfig.tests.json",
    "dev": "tsc -b packages/cli packages/server && node packages/cli/dist/bin.js serve",
    "start": "node packages/cli/dist/bin.js serve",
    "mercury": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
